# Токен бота (получить в @BotFather через /token)
BOT_TOKEN=7000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram ID Маши (узнать через @userinfobot или из чатов)
# Числовой ID, например 123456789
ADMIN_CHAT_ID=123456789

# Т‑Банк (EACQ API v2) — оплата онлайн-уроков
# Тестовый терминал (для проверки оплаты в песочнице)
TBANK_TERMINAL_KEY_TEST=your_test_terminal_key
TBANK_PASSWORD_TEST=your_test_password
# Боевой терминал (реальные деньги)
TBANK_TERMINAL_KEY_LIVE=your_live_terminal_key
TBANK_PASSWORD_LIVE=your_live_password
# 1 = тестовый терминал, 0 = боевой
TBANK_TEST_MODE=1